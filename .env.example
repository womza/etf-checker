# Copy this file to .env to override the defaults in config.py.

# Base URL of the ETF provider website, without trailing slash (required)
BASE_URL=

# Maximum seconds to wait for each HTTP request
REQUEST_TIMEOUT=20
# Minimum pause (seconds) between requests to the Simplify website
REQUEST_DELAY=1.5
# Retries on network errors or HTTP 429/5xx
MAX_RETRIES=3
# Max age in business days of NAV/Price/holdings dates before they count as stale
MAX_DATA_AGE_BUSINESS_DAYS=3
# Folder where reports and logs are saved
REPORTS_DIR=reports
# File log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
